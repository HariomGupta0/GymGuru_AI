# ==============================================================================
# GymGuru AI - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and populate with your own API credentials:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual '.env' file containing real secret keys!
# ==============================================================================

# [Required for AI Voice Coach]
# Get your free API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# [Optional - WebRTC TURN Server for Cloud Hosting (Streamlit Cloud)]
# Direct peer-to-peer WebRTC works out-of-the-box on localhost via Google STUN.
# If deploying to cloud containers behind strict firewalls, configure a TURN relay:
# TURN_URL=turn:global.relay.metered.ca:443
# TURN_USERNAME=your_turn_username
# TURN_PASSWORD=your_turn_password
